linetype = "solid",
linewidth = 0.5
) +
geom_smooth(
method = "lm",  # Linear regression
se = FALSE,     # Hide confidence interval
color = custom_palette[3],  # Use a different color from custom_palette
linewidth = 0.8,
linetype = "dashed"
) +
labs(
title = "How are Rent and Growth Related?",
x = "Rent Per SqFt",
y = "Growth % (0-4)"
) +
fit_theme() +
theme(
legend.position = "right",
panel.grid.major.x = element_line(color = "gray90", linewidth = 0.2)
)
club_stat
club_stat %>% group_by(CAGRYears04Cat) %>%
summarise(n = n())
# =============================================
# STEP 2: FEATURE SELECTION
# =============================================
# Remove irrelevant fields
club_stat <- club_perf_stat %>%
filter(!is.na(CAGRYears04)) %>%
select(
-ClubNumber, -ClubName, -City, -Address, -ZipCode, -Latitude, -Longitude,
-MarketClass, -TimeZone, -OpenDate, -MaturityDate, -MaturityFlag,
-AnnualRent, -ClosestClub, -OpenYear, -ClubNameAlt, -Year, -YearNumber, -ActiveMembers,
-Revenue, -EBITDA, -CAGRYears47, -CAGRYears47PercRank, -CAGRYears47Cat,
-CAGRYears04, -CAGRYears04PercRank, -EBITDAPerSqFtCat
) %>%
# Remove highly correlated features
select(
-TAMedHHNetWorth, -TAFamilyHH, -PopAdult44, -PopAdult64, -TAPopMale
) %>%
# Remove features that are out of time
select(
-RevenuePerSqFt, -RevenuePerSqFtPercRank, -RevenuePerSqFtCat,
-EBITDAPerSqFt, -EBITDAPerSqFtPercRank
)
club_stat %>% group_by(CAGRYears04Cat) %>%
summarise(n = n())
# =============================================
# STEP 3: OUTCOME VARIABLE
# =============================================
# Create binary outcome as a factor
club_stat <- club_stat %>%
mutate(outcome = factor(ifelse(CAGRYears04Cat == "High", 1, 0), levels = c(0, 1))) %>%
select(-CAGRYears04Cat)
# Set variable of interest i.e. positive class as a reference level
club_stat <- club_stat %>%
mutate(outcome = relevel(outcome, ref = "1"))
# =============================================
# STEP 4: CORRELATION ANALYSIS
# =============================================
# Select numeric variables for correlation
numeric_club <- club_stat %>%
select(where(is.numeric))
# Correlation matrix
cor_matrix <- cor(numeric_club, use = "complete.obs")
corrplot(cor_matrix, method = "color", type = "upper", tl.col = "black", order = "hclust")
# Top variables correlated with outcome
cor_values <- cor(numeric_club, as.numeric(club_stat$outcome), use = "complete.obs")
# Create a data frame with variable names and correlation values
top_cor <- tibble(
Variable = names(numeric_club),
Correlation = cor_values
) %>%
arrange(desc(abs(Correlation))) %>%
head(12)
print("Top 12 variables correlated with outcome:")
print(top_cor)
# =============================================
# STEP 5: VERIFY OUTCOME FACTOR LEVEL ORDER
# =============================================
# Confirming "1" is first, since sens/spec/precision/roc_auc below all
# depend on this for correctly identifying the positive/event class.
levels(club_stat$outcome)  # should print: [1] "1" "0"
# =============================================
# STEP 6: FEATURE ENGINEERING RECIPE
# =============================================
club_rec <- recipe(outcome ~ ., data = club_stat) %>%
step_dummy(all_nominal_predictors(), -all_outcomes()) %>%
# Remove zero-variance predictors (e.g., dummy variables)
step_zv(all_predictors()) %>%
step_impute_median(all_numeric_predictors()) %>%
step_normalize(all_numeric_predictors())
set.seed(136)
rf_spec <- rand_forest(
mtry  = round(sqrt(ncol(club_stat %>% select(-outcome)))),  # Features per split
trees = 500,
mode  = "classification"
) %>%
set_engine("ranger", importance = "impurity")
rf_wf <- workflow() %>%
add_recipe(club_rec) %>%
add_model(rf_spec)
rf_fit <- fit(rf_wf, data = club_stat)
# Visualize feature importance
rf_fit %>%
extract_fit_parsnip() %>%
vip(geom = "point", num_features = 20, plot_args = list(size = 3, color = "blue"))
# Extract feature importance from the RF model
rf_importance <- rf_fit %>%
extract_fit_parsnip() %>%
vi() %>%
mutate(
Importance = as.numeric(Importance),
Variable = reorder(Variable, Importance)  # Order by importance
) %>%
head(20)  # Show top 20 features for clarity
saveRDS(rf_importance, file = "./data/rf_growth_importance.rds")
# Create the plot
ggplot(rf_importance, aes(x = Importance, y = Variable, fill = Importance)) +
geom_col(width = 0.7, alpha = 0.9) +  # Horizontal bars with gradient fill
scale_fill_gradient(
low = "#0077bb",   # Blue for lower importance
high = "#ee7733",  # Orange for higher importance
name = "Importance Score"
) +
scale_x_continuous(
labels = comma,   # Format axis labels
name = "Importance Score"
) +
labs(
title = "Random Forest Feature Importance",
subtitle = "Top 20 Features by Mean Decrease in Gini",
x = NULL,
y = NULL
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, size = 10),
axis.text.y = element_text(size = 9, color = "black"),
legend.position = "right",
panel.grid.major.y = element_blank(),  # Remove horizontal grid lines
panel.grid.minor = element_blank()
)
# Top features by importance
rf_var_imp <- rf_fit %>%
extract_fit_parsnip() %>%
vi() %>%
arrange(desc(Importance)) %>%
head(10)
important_features <- rf_var_imp$Variable
print("Top 10 features from Random Forest:")
print(important_features)
# =============================================
# STEP 8: BUILD SHARED CV FOLDS ON SELECTED FEATURES
# =============================================
# Preprocess the FULL dataset, then subset to the top-10 features + outcome.
# Both the baseline and final models below use these SAME folds so their
# CV performance is directly comparable.
prepped_data <- bake(prep(club_rec, training = club_stat), new_data = club_stat) %>%
select(all_of(important_features), outcome)
set.seed(456)
folds <- vfold_cv(prepped_data, v = 8, repeats = 3, strata = outcome)  # stratified given 46/16 imbalance
# =============================================
# STEP 9: BASELINE MODEL — LOGISTIC REGRESSION
# =============================================
logit_spec <- logistic_reg(penalty = 0.01, mixture = 0.5) %>%  # elastic net
set_engine("glmnet")
# No further preprocessing needed -- prepped_data is already dummy-encoded,
# imputed, and normalized from club_rec above.
logit_rec <- recipe(outcome ~ ., data = prepped_data)
logit_wf <- workflow() %>%
add_recipe(logit_rec) %>%
add_model(logit_spec)
logit_cv_results <- fit_resamples(
logit_wf,
resamples = folds,
metrics   = metric_set(accuracy, sens, spec, yardstick::precision, roc_auc),
control   = control_resamples(save_pred = TRUE)
)
print("Baseline (Logistic Regression) CV Metrics:")
collect_metrics(logit_cv_results)
# Adjust threshold of 0.5 because recall (sensitivity) = 0.33
library(probably)
logit_preds <- collect_predictions(logit_cv_results)
# Try a range of thresholds and see the sens/spec/precision trade-off at each
threshold_data <- logit_preds %>%
threshold_perf(
truth      = outcome,
estimate   = .pred_1,
thresholds = seq(0.1, 0.9, by = 0.05),
metrics    = metric_set(sens, spec, yardstick::precision, j_index)
)
# Plot with all four metrics
threshold_data %>%
ggplot(aes(x = .threshold, y = .estimate, color = .metric)) +
geom_line(linewidth = 1) +
labs(title = "Threshold vs. Sens/Spec/Precision/J-Index",
x = "Classification Threshold", y = "Metric Value")
# Find threshold that maximizes Youden's J (sens + spec - 1) as one reasonable choice
best_threshold <- threshold_data %>%
filter(.metric == "j_index") %>%
arrange(desc(.estimate)) %>%
slice(1)
print(best_threshold)
# Full picture across all thresholds
threshold_data %>%
pivot_wider(names_from = .metric, values_from = .estimate) %>%
arrange(.threshold) %>%
print(n = Inf)
# =============================================
# STEP 10: FINAL MODEL — RANDOM FOREST (NON-LINEAR)
# =============================================
rf_final_spec <- rand_forest(
mtry  = round(sqrt(ncol(prepped_data %>% select(-outcome)))),
trees = 500,
mode  = "classification"
) %>%
set_engine("ranger")
rf_final_wf <- workflow() %>%
add_recipe(logit_rec) %>%       # same reduced feature set, no extra preprocessing needed
add_model(rf_final_spec)
rf_cv_results <- fit_resamples(
rf_final_wf,
resamples = folds,              # SAME folds as baseline for fair comparison
metrics   = metric_set(accuracy, sens, spec, yardstick::precision, roc_auc),
control   = control_resamples(save_pred = TRUE)
)
print("Final (Random Forest) CV Metrics:")
collect_metrics(rf_cv_results)
# Check thresholds
rf_preds <- collect_predictions(rf_cv_results)
rf_threshold_data <- rf_preds %>%
threshold_perf(
truth      = outcome,
estimate   = .pred_1,
thresholds = seq(0.1, 0.6, by = 0.05),
metrics    = metric_set(yardstick::precision, sens, spec, j_index)
)
# Plot with all four metrics
rf_threshold_data %>%
ggplot(aes(x = .threshold, y = .estimate, color = .metric)) +
geom_line(linewidth = 1) +
labs(title = "Threshold vs. Sens/Spec/Precision/J-Index",
x = "Classification Threshold", y = "Metric Value")
# Full picture across all thresholds
rf_threshold_data %>%
pivot_wider(names_from = .metric, values_from = .estimate) %>%
arrange(.threshold) %>%
print(n = Inf)
rf_threshold_data %>%
filter(.metric == "precision") %>%
arrange(desc(.estimate)) %>%
print(n = Inf)
q()
# Load required libraries
library(tidyverse)
library(duckdb)
library(lubridate)
# ============================================================================
# 1: READ DATA FILES INTO DATAFRAMES
# ============================================================================
# Read the CSV files from the data folder
club_dim <- read_csv("./data/club_master.csv")
club_members_month <- read_csv("./data/active_members.csv")
club_fin <- read_csv("./data/club_financial.csv")
club_rev <- read_csv("./data/fin_revenue.csv")
club_eft <- read_csv("./data/fin_eft_dues.csv")
club_ebitda <- read_csv("./data/fin_ebitda.csv")
# Clean bottom rows in club_rev
club_rev <- club_rev %>%
slice(1:(n() - 15))
# Clean bottom rows in club_eft
club_eft <- club_eft %>%
slice(1:(n() - 10))
# Clean bottom rows in club_ebitda
club_ebitda <- club_ebitda %>%
slice(1:(n() - 18))
# Rename columns in Club Dim
club_dim <- club_dim %>%
rename(
OverallScore = `Overall Score`,
TradeAreaScore = `Trade Area Score`,
SiteScore = `Site Score`,
ClosestClub = `Closest Club`,
InterstateVisibility = InterstateStateVisibility
)
# Rename columns in Financials
club_rev <- club_rev %>%
rename(
ClubLocation = `TTM Revenue`,
OpenDate = `Date Open`
)
club_eft<- club_eft %>%
rename(
ClubLocation = `Monthly Dues`,
OpenDate = `Date Open`
)
club_ebitda <- club_ebitda %>%
rename(
ClubLocation = `TTM EBITDA`,
OpenDate = `Date Open`
)
members <- club_members_month %>%
pivot_longer(
cols = -c(ClubLocation, ClubNumber),
names_to = "MonthDate",
values_to = "ActiveMembers"
) %>%
mutate(
MonthDate = as.Date(MonthDate, format = "%m/%d/%Y")
)
revenue <- club_rev %>%
pivot_longer(
cols = -c(ClubLocation, State, OpenDate),
names_to = "MonthDate",
values_to = "Revenue"
)
eft_dues <- club_eft %>%
pivot_longer(
cols = -c(ClubLocation, State, OpenDate),
names_to = "MonthDate",
values_to = "EFTDues"
)
ebitda <- club_ebitda %>%
pivot_longer(
cols = -c(ClubLocation, State, OpenDate),
names_to = "MonthDate",
values_to = "EBITDA"
)
# Convert columns to factor
club_dim$ClubName <- as.factor(club_dim$ClubName)
club_dim$City <- as.factor(club_dim$City)
club_dim$State <- as.factor(club_dim$State)
club_dim$Region <- as.factor(club_dim$Region)
club_dim$PopDensityType <- as.factor(club_dim$PopDensityType)
club_dim$ADA <- as.factor(club_dim$ADA)
club_fin$ClubName <- as.factor(club_fin$ClubName)
club_dim$MarketClass <- as.factor(club_dim$MarketClass)
club_dim$StoreClass <- as.factor(club_dim$StoreClass)
# Convert columns to date
club_dim$OpenDate <- as.Date(club_dim$OpenDate, format = "%m/%d/%Y")
club_dim$MaturityDate <- as.Date(club_dim$MaturityDate, format = "%m/%d/%Y")
revenue$MonthDate <- my(revenue$MonthDate)  # lubridate
eft_dues$MonthDate <- my(eft_dues$MonthDate)
ebitda$MonthDate <- my(ebitda$MonthDate)
# Add OpenYear
club_dim$OpenYear <- as.integer(year(club_dim$OpenDate))
club_dim <- club_dim %>%
mutate(
PopulationRange = case_when(
MarketClass == 1 ~ "2.5M+",
MarketClass == 2 ~ "1M",
MarketClass == 3 ~ "500K",
MarketClass == 4 ~ "200K",
MarketClass == 5 ~ "80K",
MarketClass == 6 ~ "< 80K",
MarketClass == 7 ~ "Non-Urban",
TRUE ~ "Unknown"
)
) %>%
mutate(
PopulationRange = factor(
PopulationRange,
levels = c("Non-Urban", "< 80K", "80K", "200K", "500K", "1M", "2.5M+")
)
)
# Filter out clubs that opened in 2025 or later: five in 2025 and two in 2026
club_dim <- club_dim %>%
filter(OpenDate < as.Date("2025-01-01"))  # Only clubs opened before 2025
# Shift OpenYear for Frederick, Bowie and Hagerstown because Members data start in 2015
club_dim <- club_dim %>%
mutate(
OpenYear = ifelse(ClubNumber %in% c(101, 102, 103), 2010, OpenYear)
)
# Clean dollar amounts for financial data
clean_and_convert <- function(column) {
#Remove hyphens followed by empty spaces
cleaned_column <- gsub("-\\s*", "", column)
#Remove commas
cleaned_column <- gsub(",", "", cleaned_column)
#Remove any remaining non-numeric characters (except digits, decimal points, parenthesis and leading hyphens)
cleaned_column <- gsub("\\(([0-9.,]+)\\)", "-\\1", cleaned_column)
# Step 5: Convert to numeric, replacing NA or empty strings with 0
as.numeric(ifelse(cleaned_column == "" | is.na(cleaned_column), 0, cleaned_column))
}
# Apply clean dollar amounts function
revenue$Revenue <- clean_and_convert(revenue$Revenue)
eft_dues$EFTDues <- clean_and_convert(eft_dues$EFTDues)
ebitda$EBITDA <- clean_and_convert(ebitda$EBITDA)
# Clean member records with null values
members_df <- members %>%
filter(!is.na(ActiveMembers))
# Clean financial data
revenue_df <- revenue %>%
filter(!is.na(Revenue))
eft_dues_df <- eft_dues %>%
filter(!is.na(EFTDues))
ebitda_df <- ebitda %>%
filter(!is.na(EBITDA))
club_dim %>% filter(ClubNumber %in% c(601, 602, 603, 604, 605, 606, 607, 608, 609, 610, 651)) %>% select(ClubNumber, ClubName, State)
str(club_dim)
# Count clubs by state
state_counts <- club_dim %>%
count(State)
# View the result
state_counts
club_dim %>% count()
# Add new columna to club_dim
club_dim$ClubNameAlt <- gsub("^\\d+\\s*-\\s*", "", club_dim$ClubName)
# Define the mapping dictionary (named list)
club_mapping <- list(
"NY Ave" = "Ivy City",
"Columbia-MD" = "Columbia, MD",
"Upper Marlboro'" = "Upper Marlboro",
"Mt Juliet" = "Mt. Juliet",
"La Vergne" = "LaVergne",
"N Miami Beach" = "North Miami Beach",
"Port Orchard'" = "Port Orchard",
"Smokey Point'" = "Smokey Point"
)
# No club found in Club Master
# "Federal Way"
# "Randallstown"
# "Sevierville"
# "Coral Springs"
# "Margate"
# "Pine Street"
# "Silverdale"
# "Sequim"
# "Bellingham"
# "Seattle UW"
# "San Mateo"
# "Silverdale
# "Centralia"
# Function to update ClubLocation for financial datasets
update_club_location <- function(df) {
df %>%
mutate(ClubLocation = recode(ClubLocation, !!!club_mapping))
}
# Function to join with club_dim and select ClubNumber, MonthDate, and the value column
join_and_select <- function(df, value_col) {
club_dim %>%
select(ClubNumber, OpenYear, ClubNameAlt) %>%
inner_join(df, by = c("ClubNameAlt" = "ClubLocation")) %>%
select(ClubNumber, OpenYear, MonthDate, !!sym(value_col))
}
# Apply the functions to each dataframe
revenue_df <- revenue_df %>%
update_club_location() %>%
join_and_select("Revenue")
eft_dues_df <- eft_dues_df %>%
update_club_location() %>%
join_and_select("EFTDues")
ebitda_df <- ebitda_df %>%
update_club_location() %>%
join_and_select("EBITDA")
club_dim_counts <- club_dim %>%
count(State)
rev_counts <- revenue_df %>%
count(State)
club_dim_counts <- club_dim %>%
count()
rev_counts <- revenue_df %>%
count()
eft_counts <- eft_dues_df %>%
count()
ebitda_counts <- ebitda_df %>%
count()
club_dim_counts
rev_counts
eft_counts
ebitda_counts
missing_in_revenue <- club_dim %>%
select(ClubNumber, ClubName) %>%
anti_join(distinct(revenue_df, ClubNumber), by = "ClubNumber")
missing_in_ebitda <- club_dim %>%
select(ClubNumber, ClubName) %>%
anti_join(distinct(ebitda_df, ClubNumber), by = "ClubNumber")
# View the result
missing_in_revenue
missing_in_ebitda
missing_in_revenue <- club_dim %>%
select(ClubNumber, ClubName, State) %>%
anti_join(distinct(revenue_df, ClubNumber), by = "ClubNumber")
missing_in_ebitda <- club_dim %>%
select(ClubNumber, ClubName, State) %>%
anti_join(distinct(ebitda_df, ClubNumber), by = "ClubNumber")
# View the result:  MI clubs are missing
missing_in_revenue
missing_in_ebitda
# Load libraries
library(tidyverse)
library(dplyr)
library(knitr)
# Read data
club_master <- readRDS("./data/club_master.rds")
members_year <- readRDS("./data/members_year.rds")
club_performance <- readRDS("./data/club_performance.rds")
club_perf_year4 <- readRDS("./data/club_perf_year4.rds")
rf_importance <- readRDS("./data/rf_importance.rds")
# Check rows where CAGRYears47 is NULL and select specific columns
club_perf_year4 %>%
filter(is.na(CAGRYears47)) %>%
select(ClubNumber, ClubName, OpenYear, YearNumber, CAGRYears47, CAGRYears47PercRank) %>%
arrange(OpenYear, ClubNumber)
club_perf_year4 %>%
filter(is.na(CAGRYears47)) %>%
select(ClubNumber, ClubName, State, OpenYear, YearNumber) %>%
arrange(OpenYear, ClubNumber)
View(club_performance)
q()
